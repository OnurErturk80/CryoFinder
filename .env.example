# Bu dosyayı .env olarak kopyalayıp doldurun (.env git'e GİRMEZ).
# Azure portalındaki "Application (client) ID"
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# OneDrive kökünden itibaren dosya yolu (geliştirme: test dosyası)
ONEDRIVE_TEST_PATH=TANK_HARITASI_TEST.xlsx
# Gerçek dosya (yalnızca --production ile kullanılır)
ONEDRIVE_PROD_PATH=TANK_HARITASI.xlsx

# Yedeklerin alınacağı OneDrive klasörü
ONEDRIVE_BACKUP_FOLDER=Yedekler
